{
  "name": "unramble-video",
  "private": true,
  "type": "module",
  "description": "Remotion source for the unramble README demo and social preview.",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio --ipv4 --port 3123",
    "brand": "python3 scripts/build_brand.py",
    "render:demo": "remotion render src/index.ts Demo ../assets/demo.mp4 --codec=h264 --crf=18 --muted --concurrency=2",
    "render:gif": "sh scripts/make-gif.sh ../assets/demo.mp4 ../assets/demo.gif",
    "render:social": "remotion still src/index.ts SocialPreview ../assets/social-preview.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
