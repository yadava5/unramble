#!/usr/bin/python3 -I
"""Store the Anthropic API key that claude-refine (Ctrl+G) uses, in the macOS login Keychain.

  claude-refine-key            paste the key at a hidden prompt; it is checked, then saved
  claude-refine-key status     is a key saved, and does it still work?
  claude-refine-key remove     delete it

Isolation, by construction:
  - The key goes only into the Keychain, never into a file, an env var or shell history.
    No file means nothing for git to pick up.
  - Only claude-refine reads it, and sends it only as the x-api-key header to
    api.anthropic.com. It is never exported as ANTHROPIC_API_KEY, so Claude Code,
    `claude -p` and other tools keep using your Max login and never see it.
  - It reaches `security` on stdin (`security -i`), not argv, so `ps` never shows it.
"""
import getpass, json, re, subprocess, sys, urllib.error, urllib.request

SERVICE, ACCOUNT = "claude-refine-anthropic-api", "api-key"
LABEL = "claude-refine (Ctrl+G prompt rewrite) - Anthropic API key"
SECURITY = "/usr/bin/security"


def check(key):
    """GET /v1/models: proves the key works and costs no tokens."""
    req = urllib.request.Request("https://api.anthropic.com/v1/models?limit=100",
                                 headers={"x-api-key": key, "anthropic-version": "2023-06-01"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            ids = [m["id"] for m in json.load(r)["data"]]
        return True, sorted(i for i in ids if "sonnet" in i)[-1:] or ids[:1]
    except urllib.error.HTTPError as e:
        try:  # Anthropic's own explanation; it never echoes the key
            msg = json.loads(e.read())["error"]["message"]
        except Exception:
            msg = ""
        return False, f"HTTP {e.code} {e.reason}: {msg}".rstrip(": ")
    except Exception as e:
        return False, str(e)


def saved():
    r = subprocess.run([SECURITY, "find-generic-password", "-s", SERVICE, "-a", ACCOUNT, "-w"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "set"
    if cmd == "status":
        key = saved()
        if not key:
            print("No key saved. Run: claude-refine-key")
            return 1
        ok, info = check(key)
        print(f"Saved key ...{key[-4:]}: " + (f"works (newest Sonnet: {info[0]})" if ok else f"FAILS: {info}"))
        return 0 if ok else 1
    if cmd == "remove":
        r = subprocess.run([SECURITY, "delete-generic-password", "-s", SERVICE, "-a", ACCOUNT],
                           capture_output=True, text=True)
        print("Removed." if r.returncode == 0 else "Nothing to remove.")
        return 0
    if cmd != "set":
        print(__doc__)
        return 2

    key = getpass.getpass("Paste the API key from platform.claude.com (hidden), then Enter: ").strip()
    if not re.fullmatch(r"sk-ant-[A-Za-z0-9_-]{20,}", key):
        print("That does not look like an Anthropic API key (sk-ant-...). Nothing saved.")
        return 1
    print("Checking it with Anthropic (a model listing; costs nothing)...")
    ok, info = check(key)
    if not ok:
        kind = re.match(r"sk-ant-[a-z]+\d*", key).group(0)  # e.g. sk-ant-api03; not secret
        print(f"The key did not work: {info}")
        print(f"(key type {kind}, {len(key)} characters) Nothing saved.")
        if kind.startswith("sk-ant-admin"):
            print("That is an Admin key. Create a normal API key under API keys in the Console.")
        return 1
    cmd_line = (f'add-generic-password -U -s "{SERVICE}" -a "{ACCOUNT}" -l "{LABEL}" '
                f'-j "Used only by ~/.local/bin/claude-refine" -w "{key}"\n')
    r = subprocess.run([SECURITY, "-i"], input=cmd_line, capture_output=True, text=True)
    if saved() != key:
        print("Saving to the Keychain failed:", (r.stderr or r.stdout).strip()[:200])
        return 1
    print(f"Saved key ...{key[-4:]} to your login Keychain as '{SERVICE}'.")
    print(f"Ctrl+G now rewrites with {info[0]} on your API credit (falls back to your login if the API fails).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
