#!/usr/bin/python3 -I
"""Ctrl+G in Claude Code: rewrite the prompt box into a clean, ordered prompt with Sonnet.

Claude Code writes the box to /tmp/.../claude-prompt-<uuid>.md, runs $VISUAL on it, and reads
the file back when this exits. Anything else that calls $VISUAL (git, fullscreen `v`) and an
empty box get a real editor. Every failure path leaves the file byte-identical.
Original text is kept in ~/.claude/cache/refine/ (last 50).
"""
import json, os, re, select, shutil, signal, subprocess, sys, termios, threading, time

REAL_EDITOR = os.environ.get("CLAUDE_REFINE_EDITOR", "/usr/bin/vim")
MODEL = os.environ.get("CLAUDE_REFINE_MODEL", "sonnet")  # alias: follows new releases
TIMEOUT = 45
MAX_CHARS = 12000  # beyond this it is a paste or a log, not dictation
HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".claude", "cache", "refine")
SYSTEM = os.path.join(HOME, ".claude", "refine", "system.md")
NEUTRAL = os.path.join(CACHE, "cwd")  # empty dir: no project CLAUDE.md, agents or hooks load


def tty(msg):
    try:
        with open("/dev/tty", "w") as t:
            t.write(f"\r\x1b[2K{msg}")
    except OSError:
        pass


def real_editor(args):
    os.execv(REAL_EDITOR, [REAL_EDITOR] + args)


def tokens(text):
    """Machine values that must survive verbatim: paths, flags, 2+ digit numbers, URLs, placeholders."""
    t = set(re.findall(r"(?:~|/)[\w.\-/]{3,}", text))
    t |= set(re.findall(r"(?<!\w)--[a-z][\w-]+", text))
    t |= set(re.findall(r"https?://\S+", text))
    t |= set(re.findall(r"\b\d{2,}(?:[.,]\d+)?\b", text))
    t |= set(re.findall(r"\[(?:Pasted text|Image) #\d+[^\]]*\]", text))
    t |= set(re.findall(r"@\S+", text))
    return {x.rstrip(".,)") for x in t}


def wait_with_keys(proc, payload):
    """Wait for the rewrite while reading keys ourselves. Ctrl+C must NOT become SIGINT: the
    signal goes to the whole foreground group and ends the Claude Code session (seen 10-17).
    So ISIG is off for the wait, and Ctrl+C / Esc are read as plain bytes meaning cancel."""
    box = {}
    th = threading.Thread(target=lambda: box.update(out=proc.communicate(payload)[0]), daemon=True)
    th.start()
    deadline = time.time() + TIMEOUT
    try:
        fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        th.join(TIMEOUT)
        return ("ok", box.get("out", "")) if not th.is_alive() else ("timeout", "")
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO | termios.ISIG)
    termios.tcsetattr(fd, termios.TCSANOW, new)
    try:
        while th.is_alive():
            if time.time() > deadline:
                return "timeout", ""
            if select.select([fd], [], [], 0.1)[0] and re.search(rb"[\x03\x1b]", os.read(fd, 64)):
                return "cancel", ""
        return "ok", box.get("out", "")
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)
        os.close(fd)


def is_machine(line):
    """A line that looks pasted (log, code, config, table) rather than spoken."""
    # placeholders, URLs and @refs are guarded by tokens(); judge the rest of the line
    bare = re.sub(r"\[(?:Pasted text|Image) #\d+[^\]]*\]|https?://\S+|@\S+", "", line.strip()).strip()
    if len(bare) < 20:
        return False
    prose = sum(c.isalpha() or c == " " for c in bare) / len(bare)
    return prose < 0.8 or bool(re.match(r"[{(<#$>|`]|\w+\(|\d{4}-\d\d-\d\d", bare))


def mask(text):
    """Swap each run of pasted lines for a [[paste N]] marker so the model never sees, slows on,
    or alters them; unmask() puts them back byte-for-byte."""
    lines, out, blocks, i = text.split("\n"), [], [], 0
    while i < len(lines):
        if not is_machine(lines[i]):
            out.append(lines[i])
            i += 1
            continue
        j = i
        while j < len(lines) and (is_machine(lines[j]) or (not lines[j].strip() and j + 1 < len(lines)
                                                          and is_machine(lines[j + 1]))):
            j += 1
        blocks.append("\n".join(lines[i:j]))
        out.append(f"[[paste {len(blocks)}]]")
        i = j
    return "\n".join(out), blocks


def unmask(text, blocks):
    for n, block in enumerate(blocks, 1):
        marker = f"[[paste {n}]]"
        if text.count(marker) != 1:
            return None
        text = text.replace(marker, block)
    return text


def main():
    args = sys.argv[1:]
    path = args[-1] if args else ""
    if not re.match(r"claude-prompt-.*\.md$", os.path.basename(path)):
        real_editor(args)
    src = open(path, encoding="utf-8").read()
    body = src.strip()
    if not body:
        real_editor(args)
    if body[0] in "/!" or len(body) > MAX_CHARS:
        tty("refine: skipped (slash command, shell escape or paste-sized text)\n")
        time.sleep(1.2)
        return

    os.makedirs(NEUTRAL, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    open(os.path.join(CACHE, f"{stamp}.md"), "w", encoding="utf-8").write(src)
    for old in sorted(f for f in os.listdir(CACHE) if f.endswith(".md"))[:-50]:
        os.remove(os.path.join(CACHE, old))

    masked, blocks = mask(body)
    tty(f"refine: rewriting with {MODEL}… (Esc or Ctrl+C keeps your text)")
    t0 = time.time()
    claude = shutil.which("claude") or os.path.join(HOME, ".local", "bin", "claude")
    try:
        proc = subprocess.Popen(
            [claude, "-p", "--model", MODEL, "--no-session-persistence",
             "--setting-sources", "project,local", "--system-prompt", open(SYSTEM).read(),
             "--tools", "", "--output-format", "json"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
            cwd=NEUTRAL, start_new_session=True)
    except OSError as e:
        tty(f"refine: could not start claude ({e.strerror}) — your text is unchanged\n")
        time.sleep(2.5)
        return
    status, out = wait_with_keys(proc, f"<transcript>\n{masked}\n</transcript>")
    if status != "ok":
        os.killpg(proc.pid, signal.SIGTERM)
        tty("refine: " + ("cancelled" if status == "cancel" else f"timed out after {TIMEOUT}s")
            + " — your text is unchanged\n")
        time.sleep(1.2)
        return
    try:
        result = json.loads(out).get("result", "").strip()
    except Exception:
        result = ""
    if not result:
        tty("refine: no rewrite came back — your text is unchanged\n")
        time.sleep(1.5)
        return

    result = unmask(result, blocks)
    if result is None:
        tty("refine: kept your text — the rewrite lost or duplicated a pasted block\n")
        time.sleep(2.5)
        return
    missing = sorted(t for t in tokens(body) if t not in result)
    if missing:
        tty(f"refine: kept your text — the rewrite dropped {', '.join(missing[:4])}\n")
        time.sleep(2.5)
        return
    with open(path, "w", encoding="utf-8") as f:
        f.write(result + "\n")
    tty(f"refine: done in {time.time() - t0:.1f}s (original in ~/.claude/cache/refine/{stamp}.md)\n")
    time.sleep(0.6)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.default_int_handler)
    try:
        main()
    except KeyboardInterrupt:
        pass
