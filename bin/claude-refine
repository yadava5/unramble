#!/usr/bin/python3 -I
"""Ctrl+G in Claude Code: rewrite the prompt box into a clean, ordered prompt with Sonnet.

Claude Code writes the box to /tmp/.../claude-prompt-<uuid>.md, runs $VISUAL on it, and reads
the file back when this exits. Anything else that calls $VISUAL (git, fullscreen `v`) and an
empty box get a real editor. Every failure path leaves the file byte-identical.
Original text is kept in ~/.claude/cache/refine/ (last 50).
Engine: the Anthropic API with the Keychain key from `claude-refine-key` (Max plan's monthly API
credit) when one is stored; otherwise, or if the API call fails, `claude -p` on the plan — and
then the statusline shows `⚠ refine on plan ×N` until an API rewrite succeeds again
(cache/refine/on-plan). Every rewrite's engine is logged in cache/refine/log.jsonl.
"""
import json, os, re, select, shutil, signal, subprocess, sys, termios, threading, time
import urllib.request

REAL_EDITOR = os.environ.get("CLAUDE_REFINE_EDITOR", "/usr/bin/vim")
MODEL = os.environ.get("CLAUDE_REFINE_MODEL", "sonnet")  # alias: follows new releases
KEY_SERVICE, KEY_ACCOUNT = "claude-refine-anthropic-api", "api-key"  # see claude-refine-key
TIMEOUT = 45
MAX_CHARS = 12000  # beyond this it is a paste or a log, not dictation
HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".claude", "cache", "refine")
SYSTEM = os.path.join(HOME, ".claude", "refine", "system.md")
NEUTRAL = os.path.join(CACHE, "cwd")  # empty dir: no project CLAUDE.md, agents or hooks load


FILTER = "--filter" in sys.argv  # stdin -> stdout for the prompt-refine mod; never touches the tty


def tty(msg):
    if FILTER:  # the mod runs us beside Claude Code's live screen: stderr only
        sys.stderr.write(msg.strip("\r\n") + "\n")
        return
    try:
        with open("/dev/tty", "w") as t:
            t.write(f"\r\x1b[2K{msg}")
    except OSError:
        pass


def real_editor(args):
    os.execv(REAL_EDITOR, [REAL_EDITOR] + args)


def tokens(text):
    """Machine values that must survive verbatim: paths, flags, 2+ digit numbers, URLs, placeholders."""
    t = set(re.findall(r"(?:~|/)[\w.\-/]{3,}", text))
    t |= set(re.findall(r"(?<!\w)--[a-z][\w-]+", text))
    t |= set(re.findall(r"https?://\S+", text))
    t |= set(re.findall(r"\b\d{2,}(?:[.,]\d+)?\b", text))
    t |= set(re.findall(r"\[(?:Pasted text|Image) #\d+[^\]]*\]", text))
    t |= set(re.findall(r"@\S+", text))
    return {x.rstrip(".,)") for x in t}


def keychain_key():
    """The API key `claude-refine-key` stored. Read here only, sent only as the x-api-key header,
    never exported, so no other process (claude, claude -p, scripts) can pick it up."""
    r = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", KEY_SERVICE,
                        "-a", KEY_ACCOUNT, "-w"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def api(key, method, route, body=None, timeout=TIMEOUT):
    req = urllib.request.Request(f"https://api.anthropic.com{route}", method=method,
                                 data=json.dumps(body).encode() if body else None,
                                 headers={"x-api-key": key, "anthropic-version": "2023-06-01",
                                          "content-type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def api_model(key):
    """Newest Sonnet the API lists, re-checked daily, so a new release is picked up with no edit."""
    cache = os.path.join(CACHE, "api-model.json")
    try:
        c = json.load(open(cache))
        if time.time() - c["ts"] < 86400:
            return c["id"]
    except Exception:
        pass
    models = api(key, "GET", "/v1/models?limit=100", timeout=10)["data"]
    best = sorted((m for m in models if MODEL in m["id"]), key=lambda m: m["created_at"])[-1]["id"]
    json.dump({"id": best, "ts": time.time()}, open(cache, "w"))
    return best


# $ per million tokens (input, output), claude-api skill table cached 2026-10-06. A new model
# family falls back to the Opus row, so the ledger over-counts rather than under-counts.
PRICES = {"haiku": (0.10, 0.50), "sonnet": (2.0, 10.0), "opus": (4.0, 20.0), "fable": (10.0, 50.0)}
# The budget is the account's real credit balance, not a guessed figure (decided 10-17). No API
# returns that balance to a normal key, so it is read off the Console's billing page and recorded
# (`claude-refine --balance 96.40`); every response's usage is subtracted from it from then on.
# Credit renews on the 16th with no rollover, so a reading only holds until then; past that date
# the cap stands aside, and a credit that really runs out makes the API fail, which falls back
# to the plan with the visible warning rather than silently.
CYCLE_DAY = 16
BALANCE = os.path.join(CACHE, "balance.json")


def ledger():
    """(path, data, today): spend per local day, from each response's usage."""
    path = os.path.join(CACHE, "spend.json")
    try:
        data = json.load(open(path))
    except Exception:
        data = {}
    return path, {k: v for k, v in data.items() if k[:1].isdigit()}, time.strftime("%Y-%m-%d")


def next_renewal():
    t = time.localtime()
    y, m = (t.tm_year, t.tm_mon) if t.tm_mday < CYCLE_DAY else (
        (t.tm_year, t.tm_mon + 1) if t.tm_mon < 12 else (t.tm_year + 1, 1))
    return f"{y}-{m:02d}-{CYCLE_DAY:02d}"


def remaining():
    """Estimated credit left, or None when no reading is recorded or it predates a renewal."""
    try:
        b = json.load(open(BALANCE))
    except Exception:
        return None
    if time.strftime("%Y-%m-%d") >= b["renews"]:
        return None
    return b["usd"] - (sum(ledger()[1].values()) - b["ledger_at_reading"])


def set_balance(usd):
    json.dump({"usd": usd, "read": time.strftime("%Y-%m-%dT%H:%M"), "renews": next_renewal(),
               "ledger_at_reading": sum(ledger()[1].values())}, open(BALANCE, "w"), indent=1)


def over_cap():
    left = remaining()
    if left is not None and left <= 0:
        return f"the recorded API credit is used up (${left:.2f} left)"
    return None


def charge(model, usage):
    i, o = next((p for k, p in PRICES.items() if k in model), PRICES["opus"])
    usd = (usage.get("input_tokens", 0) * i + usage.get("output_tokens", 0) * o) / 1e6
    path, data, today = ledger()
    data[today] = round(data.get(today, 0) + usd, 5)
    json.dump(data, open(path, "w"), indent=1)


def via_api(key, payload):
    model = api_model(key)
    r = api(key, "POST", "/v1/messages", {"model": model, "max_tokens": 8000,
                                          "system": open(SYSTEM).read(),
                                          "messages": [{"role": "user", "content": payload}]})
    charge(model, r.get("usage", {}))
    return "".join(b.get("text", "") for b in r["content"]).strip()


def via_cli(payload, held):
    claude = shutil.which("claude") or os.path.join(HOME, ".local", "bin", "claude")
    held["proc"] = subprocess.Popen(
        [claude, "-p", "--model", MODEL, "--no-session-persistence",
         "--setting-sources", "project,local", "--system-prompt", open(SYSTEM).read(),
         "--tools", "", "--output-format", "json"],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        cwd=NEUTRAL, start_new_session=True)
    return json.loads(held["proc"].communicate(payload)[0]).get("result", "").strip()


def record(how, ok, secs, reason=""):
    """Log every rewrite's engine; keep refine/on-plan (count + last reason) while rewrites land
    on the plan, so the statusline shows `⚠ refine on plan ×N` until the API works again."""
    flag = os.path.join(CACHE, "on-plan")
    with open(os.path.join(CACHE, "log.jsonl"), "a") as f:
        f.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "engine": how, "ok": ok,
                            "secs": round(secs, 1), "reason": reason}) + "\n")
    if how == "API credit" and ok:
        if os.path.exists(flag):
            os.remove(flag)
    elif how == "your plan":
        try:
            n = int(open(flag).readline() or 0)
        except Exception:
            n = 0
        open(flag, "w").write(f"{n + 1}\n{time.strftime('%H:%M')} {reason}\n")


def wait_with_keys(fn):
    """Run fn() while reading keys ourselves. Ctrl+C must NOT become SIGINT: the signal goes to
    the whole foreground group and ends the Claude Code session (seen 10-17). So ISIG is off for
    the wait, and Ctrl+C / Esc are read as plain bytes meaning cancel."""
    box = {}

    def run():
        try:
            box["out"] = fn()
        except Exception as e:
            box["err"] = getattr(e, "reason", None) or getattr(e, "code", None) or type(e).__name__

    th = threading.Thread(target=run, daemon=True)
    th.start()
    deadline = time.time() + TIMEOUT
    done = lambda: ("error", str(box["err"])) if "err" in box else ("ok", box.get("out", ""))
    try:
        if FILTER:  # never take the terminal from Claude Code; the mod owns cancel/timeout
            raise OSError
        fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        th.join(TIMEOUT)
        return done() if not th.is_alive() else ("timeout", "")
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO | termios.ISIG)
    termios.tcsetattr(fd, termios.TCSANOW, new)
    try:
        while th.is_alive():
            if time.time() > deadline:
                return "timeout", ""
            if select.select([fd], [], [], 0.1)[0] and re.search(rb"[\x03\x1b]", os.read(fd, 64)):
                return "cancel", ""
        return done()
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)
        os.close(fd)


def is_machine(line):
    """A line that looks pasted (log, code, config, table) rather than spoken."""
    # placeholders, URLs and @refs are guarded by tokens(); judge the rest of the line
    bare = re.sub(r"\[(?:Pasted text|Image) #\d+[^\]]*\]|https?://\S+|@\S+", "", line.strip()).strip()
    if len(bare) < 20:
        return False
    prose = sum(c.isalpha() or c == " " for c in bare) / len(bare)
    return prose < 0.8 or bool(re.match(r"[{(<#$>|`]|\w+\(|\d{4}-\d\d-\d\d", bare))


def mask(text):
    """Swap each run of pasted lines for a [[paste N]] marker so the model never sees, slows on,
    or alters them; unmask() puts them back byte-for-byte."""
    lines, out, blocks, i = text.split("\n"), [], [], 0
    while i < len(lines):
        if not is_machine(lines[i]):
            out.append(lines[i])
            i += 1
            continue
        j = i
        while j < len(lines) and (is_machine(lines[j]) or (not lines[j].strip() and j + 1 < len(lines)
                                                          and is_machine(lines[j + 1]))):
            j += 1
        blocks.append("\n".join(lines[i:j]))
        out.append(f"[[paste {len(blocks)}]]")
        i = j
    return "\n".join(out), blocks


def unwrap(text):
    """The system prompt's examples use <rewrite> tags, and once in 80 runs Sonnet copied them,
    with a sentence about its rules in front. Keep only what is inside the tags."""
    m = re.search(r"<rewrite>\s*(.*?)\s*</rewrite>", text, re.S)
    return m.group(1) if m else text


def unmask(text, blocks):
    for n, block in enumerate(blocks, 1):
        marker = f"[[paste {n}]]"
        if text.count(marker) != 1:
            return None
        text = text.replace(marker, block)
    return text


def main():
    """Editor mode: rewrite the file in place. --filter mode (the prompt-refine mod): read the
    draft on stdin, print the rewrite on stdout; empty stdout means "keep the draft", and the
    reason is on stderr. --balance [USD]: record the Console's credit balance, or show what's left."""
    if sys.argv[1:2] == ["--balance"]:
        if sys.argv[2:]:
            set_balance(float(sys.argv[2].lstrip("$")))
        left = remaining()
        print("No balance recorded (or it predates the last renewal on the 16th). Read it from "
              "platform.claude.com → Settings → Billing, then: claude-refine --balance 96.40"
              if left is None else f"~${left:.2f} API credit left (renews {json.load(open(BALANCE))['renews']})")
        return
    if FILTER:
        time.sleep = lambda s: None
        src = sys.stdin.read()
        body = src.strip()
        if not body:
            tty("refine: nothing to rewrite")
            return
    else:
        args = sys.argv[1:]
        path = args[-1] if args else ""
        if not re.match(r"claude-prompt-.*\.md$", os.path.basename(path)):
            real_editor(args)
        src = open(path, encoding="utf-8").read()
        body = src.strip()
        if not body:
            real_editor(args)
    if body[0] in "/!" or len(body) > MAX_CHARS:
        tty("refine: skipped (slash command, shell escape or paste-sized text)\n")
        time.sleep(1.2)
        return

    os.makedirs(NEUTRAL, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    open(os.path.join(CACHE, f"{stamp}.md"), "w", encoding="utf-8").write(src)
    for old in sorted(f for f in os.listdir(CACHE) if f.endswith(".md"))[:-50]:
        os.remove(os.path.join(CACHE, old))

    masked, blocks = mask(body)
    payload = f"<transcript>\n{masked}\n</transcript>"
    t0 = time.time()
    key, how, why = keychain_key(), "your plan", "no API key saved"
    status, result = "error", ""
    if key and over_cap():  # a spent budget stops here: no quiet slide onto the plan either
        tty(f"refine: {over_cap()} — your text is unchanged\n")
        time.sleep(2.5)
        return
    if key:
        how = "API credit"
        tty(f"refine: rewriting with {MODEL} via API credit… (Esc or Ctrl+C keeps your text)")
        status, result = wait_with_keys(lambda: via_api(key, payload))
        if status == "error":  # bad key, credit used up, network: fall back, and say so
            how, why = "your plan", f"API failed: {result[:60]}"
    if status not in ("ok", "cancel", "timeout"):
        tty(f"refine: ⚠ {why} — rewriting on YOUR PLAN usage… (Esc or Ctrl+C keeps your text)")
        held = {}
        status, result = wait_with_keys(lambda: via_cli(payload, held))
        if status != "ok" and held.get("proc"):
            os.killpg(held["proc"].pid, signal.SIGTERM)
    note = f" — ⚠ used YOUR PLAN ({why})" if how == "your plan" else ""
    record(how, status == "ok" and bool(result), time.time() - t0, why if how == "your plan" else "")
    if status != "ok":
        tty("refine: " + {"cancel": "cancelled", "timeout": f"timed out after {TIMEOUT}s"}.get(
            status, f"failed ({result[:60]})") + f" — your text is unchanged{note}\n")
        time.sleep(2.5 if note else 1.5)
        return
    if not result:
        tty("refine: no rewrite came back — your text is unchanged\n")
        time.sleep(1.5)
        return

    result = unmask(unwrap(result), blocks)
    if result is None:
        tty("refine: kept your text — the rewrite lost or duplicated a pasted block\n")
        time.sleep(2.5)
        return
    missing = sorted(t for t in tokens(body) if t not in result)
    if missing:
        tty(f"refine: kept your text — the rewrite dropped {', '.join(missing[:4])}\n")
        time.sleep(2.5)
        return
    if FILTER:
        sys.stdout.write(result)
    else:
        with open(path, "w", encoding="utf-8") as f:
            f.write(result + "\n")
    left = remaining() if how == "API credit" else None
    left = f", ~${left:.2f} credit left" if left is not None else ""
    tty(f"refine: done in {time.time() - t0:.1f}s via {how}{left}{note} (original in ~/.claude/cache/refine/{stamp}.md)\n")
    time.sleep(3 if note else 0.6)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.default_int_handler)
    try:
        main()
    except KeyboardInterrupt:
        pass
